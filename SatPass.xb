100 REM ==========================
110 REM SATPASS v1.2 TI-99/4A XB
120 REM Keplerian LEO pass predictor
130 REM Next up-to-10 passes, 4 days
140 REM Coarse scan + bisection edges
150 REM Cached trig, fast Kepler solve
160 REM Height in METERS. ~5min/few deg
170 REM For Paul Stoetzer N8HM 73!
180 REM ==========================
190 CALL CLEAR
200 PRINT "=========================="
210 PRINT " SATPASS v1.2"
220 PRINT " Keplerian Pass Predictor"
230 PRINT "=========================="
240 PRINT
250 PRINT "Times UTC. Lon +E / -W."
260 PRINT "Use fresh AMSAT keps."
270 PRINT
280 REM === OBSERVER ===
290 INPUT "Obs lat (+N deg)? ":LAT
300 INPUT "Obs lon (+E deg)? ":LON
310 INPUT "Height ASL (m)? ":H
320 IF H<=0 THEN H=50
330 PRINT
340 REM === CURRENT TIME UTC ===
350 INPUT "Year (e.g. 2026)? ":YR
360 INPUT "Month (1-12)? ":MO
370 INPUT "Day? ":DA
380 INPUT "Hour UTC (0-23)? ":HR
390 INPUT "Minute (0-59)? ":MN
400 PRINT
410 REM === SAT ELEMENTS ===
420 INPUT "Sat name? ":SAT$
430 INPUT "Epoch year? ":EYR
440 INPUT "Epoch day (145.123)? ":EDAY
450 INPUT "Inclination deg? ":INC
460 INPUT "RAAN deg? ":RAAN
470 INPUT "Eccentricity? ":ECC
480 INPUT "Arg perigee deg? ":AP
490 INPUT "Mean anomaly deg? ":MA
500 INPUT "Mean motion rev/day? ":MM
510 PRINT :: PRINT "Calculating, please wait."
520 REM === CONSTANTS ===
530 D2R=PI/180
540 R2D=180/PI
550 RE=6378.14
560 MU=398600.4418
570 LATR=LAT*D2R
580 LONR=LON*D2R
590 HRAD=H/1000
600 REM === JULIAN DATES ===
610 GY=YR :: GM=MO :: GD=DA :: GH=HR :: GMI=MN :: GOSUB 2010 :: JD0=JD
620 GY=EYR :: GM=1 :: GD=1 :: GH=0 :: GMI=0 :: GOSUB 2010 :: JDE=JD+(EDAY-1)
630 REM === PRECOMPUTE CONSTANTS ===
640 SLAT=SIN(LATR) :: CLAT=COS(LATR)
650 OBSR=RE+HRAD
660 IR=INC*D2R :: RAR=RAAN*D2R
670 SIR=SIN(IR) :: CIR=COS(IR)
680 SRAR=SIN(RAR) :: CRAR=COS(RAR)
690 N=MM*2*PI :: MAR=MA*D2R
700 NRS=N/86400 :: A=(MU/(NRS*NRS))^(1/3)
710 CSTP=0.005 :: MAXD=4
720 PC=0 :: DONE=0
730 REM === INITIAL SAMPLE ===
740 CT=0
750 TD=CT :: JD=JD0+TD :: DTD=JD-JDE :: GOSUB 2110
760 PEL=EL :: PCT=CT :: INP=0
770 IF EL>0 THEN INP=1 :: AOST=0 :: AOSA=AZ
780 PRINT
790 PRINT "Sat: ";SAT$
800 PRINT " # AOS   Az  LOS   Az El"
810 PRINT "------------------------"
820 REM === COARSE SCAN ===
830 CT=CT+CSTP
840 IF DONE=1 THEN 1100
850 IF CT>MAXD THEN 1100
860 TD=CT :: JD=JD0+TD :: DTD=JD-JDE :: GOSUB 2110
870 NEL=EL :: NAZ=AZ
880 IF INP=1 THEN 950
890 IF PEL>0 THEN 1030
900 IF NEL<=0 THEN 1030
910 RA=PCT :: RB=CT :: ELA=PEL :: GOSUB 3000
920 AOST=RT :: AOSA=RAZ :: INP=1
930 GOTO 1030
950 IF NEL>0 THEN 1030
960 RA=PCT :: RB=CT :: ELA=PEL :: GOSUB 3000
970 LOST=RT :: LOSA=RAZ
980 GOSUB 3200
990 GOSUB 1500
1030 PCT=CT :: PEL=NEL
1040 GOTO 830
1090 REM === SUMMARY ===
1100 PRINT
1110 PRINT "Done. ";STR$(PC);" pass(es)"
1120 PRINT "Accuracy ~5 min, no SGP4"
1130 PRINT "Update keps often!"
1140 END
1490 REM === PRINT ONE PASS ===
1500 PC=PC+1
1510 IF PC<=10 THEN 1530
1515 INP=0
1520 RETURN
1530 AMIN=INT(HR*60+MN+AOST*1440+0.5)
1540 LMIN=INT(HR*60+MN+LOST*1440+0.5)
1550 AMIN=AMIN-1440*INT(AMIN/1440)
1560 LMIN=LMIN-1440*INT(LMIN/1440)
1570 H1=INT(AMIN/60) :: M1=AMIN-60*H1
1580 H2=INT(LMIN/60) :: M2=LMIN-60*H2
1590 TV=H1 :: GOSUB 1900 :: HH1$=T2$
1600 TV=M1 :: GOSUB 1900 :: NN1$=T2$
1610 TV=H2 :: GOSUB 1900 :: HH2$=T2$
1620 TV=M2 :: GOSUB 1900 :: NN2$=T2$
1630 TV=INT(AOSA) :: TW=3 :: GOSUB 1950 :: AZ1$=SP$
1640 TV=INT(LOSA) :: TW=3 :: GOSUB 1950 :: AZ2$=SP$
1650 TV=INT(MXEL) :: TW=2 :: GOSUB 1950 :: ELP$=SP$
1660 TV=PC :: TW=2 :: GOSUB 1950 :: PN$=SP$
1670 PRINT PN$;" ";HH1$;":";NN1$;" ";AZ1$;" ";HH2$;":";NN2$;" ";AZ2$;" ";ELP$
1680 IF PC>=10 THEN DONE=1
1685 INP=0
1690 RETURN
1900 REM zero-pad to 2 -> T2$
1910 T2$=STR$(INT(TV))
1920 IF LEN(T2$)<2 THEN T2$="0"&T2$
1930 RETURN
1940 REM space-pad TV to width TW -> SP$
1950 SP$=STR$(INT(TV))
1960 IF LEN(SP$)<TW THEN SP$=SEG$("     ",1,TW-LEN(SP$))&SP$
1970 RETURN
2000 REM === JULIAN DATE (GY GM GD GH GMI -> JD) ===
2010 IF GM<=2 THEN GY=GY-1 :: GM=GM+12
2020 A=INT(GY/100) :: B=2-A+INT(A/4)
2030 JD=INT(365.25*(GY+4716))+INT(30.6001*(GM+1))+GD+B-1524.5
2040 JD=JD+(GH+GMI/60)/24
2050 RETURN
2100 REM === SAT POSITION -> EL,AZ ===
2110 M=MAR+N*DTD
2120 M=M-INT(M/(2*PI))*(2*PI)
2130 IF M<0 THEN M=M+2*PI
2140 E=M
2150 FOR KK=1 TO 12
2160 SE=SIN(E) :: CE=COS(E)
2170 F=E-ECC*SE-M :: FP=1-ECC*CE
2180 DE=F/FP :: E=E-DE
2190 IF ABS(DE)<1E-8 THEN KK=99
2200 NEXT KK
2210 CE=COS(E) :: SE=SIN(E)
2220 CNU=(CE-ECC)/(1-ECC*CE)
2230 SNU=SE*SQR(1-ECC*ECC)/(1-ECC*CE)
2240 NU=ATN(SNU/CNU)
2250 IF CNU<0 THEN NU=NU+PI
2260 IF NU<0 THEN NU=NU+2*PI
2270 R=A*(1-ECC*CE)
2280 U=NU+AP*D2R
2290 CU=COS(U) :: SU=SIN(U)
2300 X=R*(CRAR*CU-SRAR*SU*CIR)
2310 Y=R*(SRAR*CU+CRAR*SU*CIR)
2320 Z=R*(SU*SIR)
2330 TT=(JD-2451545)/36525
2340 GM2=280.46061837+360.98564736629*(JD-2451545)
2350 GM2=GM2+0.000387933*TT*TT-TT*TT*TT/38710000
2360 GM2=GM2-INT(GM2/360)*360
2370 IF GM2<0 THEN GM2=GM2+360
2380 LST=GM2*D2R+LONR
2390 LST=LST-INT(LST/(2*PI))*(2*PI)
2400 IF LST<0 THEN LST=LST+2*PI
2410 CLST=COS(LST) :: SLST=SIN(LST)
2420 XO=OBSR*CLAT*CLST
2430 YO=OBSR*CLAT*SLST
2440 ZO=OBSR*SLAT
2450 DX=X-XO :: DY=Y-YO :: DZ=Z-ZO
2460 RE2=-DX*SLST+DY*CLST
2470 RN=-DX*SLAT*CLST-DY*SLAT*SLST+DZ*CLAT
2480 RU=DX*CLAT*CLST+DY*CLAT*SLST+DZ*SLAT
2490 GR=SQR(RE2*RE2+RN*RN)
2500 SR=SQR(GR*GR+RU*RU)
2510 IF SR>=1 THEN 2530
2520 EL=-90 :: AZ=0 :: RETURN
2530 IF GR>=1E-4 THEN 2550
2540 EL=90 :: AZ=0 :: RETURN
2550 EL=ATN(RU/GR)*R2D
2560 AZ=ATN(RE2/RN)*R2D
2570 IF RN<0 THEN AZ=AZ+180
2580 IF AZ<0 THEN AZ=AZ+360
2590 RETURN
3000 REM === FIND EL=0 IN [RA,RB] -> RT,RAZ ===
3010 FOR KR=1 TO 6
3020 RM=(RA+RB)/2
3030 TD=RM :: JD=JD0+TD :: DTD=JD-JDE :: GOSUB 2110
3040 IF EL*ELA<=0 THEN 3070
3050 RA=RM :: ELA=EL
3060 GOTO 3080
3070 RB=RM
3080 NEXT KR
3090 RT=(RA+RB)/2
3100 TD=RT :: JD=JD0+TD :: DTD=JD-JDE :: GOSUB 2110
3110 RAZ=AZ
3120 RETURN
3200 REM === MAX EL OVER AOST..LOST -> MXEL ===
3210 MXEL=0 :: DUR=LOST-AOST
3220 FOR KS=1 TO 9
3230 TS=AOST+DUR*KS/10
3240 TD=TS :: JD=JD0+TD :: DTD=JD-JDE :: GOSUB 2110
3250 IF EL>MXEL THEN MXEL=EL
3260 NEXT KS
3270 RETURN
